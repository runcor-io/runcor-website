# RunCor Environment Variables
# Copy this file to .env.local and fill in your values

# MongoDB Connection String
# Local: mongodb://localhost:27017/runcor
# Atlas: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/runcor?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/runcor

# NextAuth Secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your_secret_key_here

# NextAuth URL (your domain)
# Local: http://localhost:3000
# Production: https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# Optional: Admin API Key for additional security
# ADMIN_API_KEY=your_admin_api_key
